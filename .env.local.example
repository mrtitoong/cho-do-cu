# Sao chép file này thành .env.local rồi điền giá trị từ Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Địa chỉ website khi đã đưa lên mạng (dùng cho sitemap.xml, robots.txt, ảnh xem trước khi chia sẻ link).
# Bỏ trống khi chạy ở máy; trên Vercel nếu bỏ trống sẽ tự dùng tên miền production của project.
NEXT_PUBLIC_SITE_URL=
